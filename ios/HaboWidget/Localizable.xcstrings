  "strings": {
    "A habit's whole year at a glance.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý rok návyku na první pohled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Jahr einer Gewohnheit auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el año de un hábito de un vistazo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ano inteiro de um hábito de relance."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý rok zvyku na prvý pohľad."
